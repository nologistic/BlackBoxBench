  "requirements": [
    {
      "requirement_id": "f01",
      "name": "新游戏配置与启动",
      "grade": "partial",
      "grade_label": "部分",
      "rationale": "NEW GAME 打开配置面板，含 GRID SIZE(4x4/5x5/6x6) 与 DIFFICULTY(易/普/難)；难度可正常选择且选中项红色高亮（点 普 后 MEDIUM 高亮；点 難 后 HARD 高亮），START 能进入对应棋盘，4x4 局底部数字键为 1–4。但 GRID SIZE 中 5x5、6x6 反复点击均无任何高亮变化，选中项始终停在 4x4，START 后仍生成 4x4 棋盘，尺寸选择不可用。",
      "evidence_observations": [
        2,
        5,
        13,
        44,
        57
      ],
      "persistence_evidence": null,
      "not_verifiable_reason": null
    },
    {
      "requirement_id": "f02",
      "name": "Futoshiki 基础数字输入",
      "grade": "full",
      "grade_label": "完整",
      "rationale": "4x4 局中点击空格出现红色选中边框，点底部数字 1 后该格写入 1，选中态可移动到别的空格继续输入。预置数字格点击后不会被选中、也无法改写（点 r4c1 的预置 3 无任何选中反应）。数字键为 1–4，与当前 4x4 匹配。可见行为上输入闭环成立；仅预置数字与玩家填入数字在非选中态样式相同（无颜色区分）。",
      "evidence_observations": [
        13,
        14,
        15,
        19
      ],
      "persistence_evidence": null,
      "not_verifiable_reason": null
    },
    {
      "requirement_id": "f03",
      "name": "行列唯一性规则",
      "grade": "full",
      "grade_label": "完整",
      "rationale": "在 r1c2 输入与本行 r1c4 及本列 r4c2 重复的 2 后，录入格立即变红，冲突的行内已有格 r1c4 与本列的预置格 r4c2 同时被红色标出；改成合法值 3 后红色全部消失。整盘完成时也必须行/列各含 1–4 一次才判定胜利，说明重复检测是实时整盘校验而非最终比答案。",
      "evidence_observations": [
        17,
        18,
        24
      ],
      "persistence_evidence": null,
      "not_verifiable_reason": null
    },
    {
      "requirement_id": "f04",
      "name": "不等式约束规则",
      "grade": "full",
      "grade_label": "完整",
      "rationale": "r1c2 与 r1c3 间有 \">\" 提示。r1c2 已为 3 时在 r1c3 输入 4，违反 3>4，两格立即同时变红报错；改填满足关系的 3（左侧 4>3）后红色消失。纵向不等式同样参与校验：整盘最后一步完成后（含全部横向与纵向不等式成立）才触发胜利，说明不等式不是被忽略的装饰。",
      "evidence_observations": [
        21,
        23,
        24
      ],
      "persistence_evidence": null,
      "not_verifiable_reason": null
    },
    {
      "requirement_id": "f05",
      "name": "完整规则联合校验",
      "grade": "full",
      "grade_label": "完整",
      "rationale": "逐格填入唯一解（每行每列 1–4 各一次且全部不等式成立）后，填最后一个空格即自动触发 YOU WON；中途出现重复或违反不等式的输入（r1c2=2 重复、r1c3=4 破坏 3>4）时都不判定完成，只显示红色错误。完成判定确实是行唯一、列唯一与全部不等式的联合校验。",
      "evidence_observations": [
        17,
        21,
        24
      ],
      "persistence_evidence": null,
      "not_verifiable_reason": null
    },
    {
      "requirement_id": "f06",
      "name": "错误输入与剩余错误次数",
      "grade": "partial",
      "grade_label": "部分",
      "rationale": "错误输入会被实时标红（重复的 2 与违反不等式的 4 均出现红色格与红色数字），改成合法值后恢复，错误反馈本身正确。但整局界面（含顶部区域）自始至终只有计时器，没有任何 \"mistakes remaining\" 之类的剩余错误次数显示；故意多次输入错误后也无法观察到次数扣减、耗尽或耗尽后的行为。错误次数维护这一子功能不可见，故只判部分。",
      "evidence_observations": [
        17,
        21,
        54
      ],
      "persistence_evidence": null,
      "not_verifiable_reason": null
    },
    {
      "requirement_id": "f07",
      "name": "Easy / Medium / Hard 难度差异",
      "grade": "full",
      "grade_label": "完整",
      "rationale": "同尺寸 4x4 下三档难度产出明显不同的线索结构：EASY 局预置数字较多（8 个）、不等式很少（约 4 个）；HARD 局预置数字仅 6 个、不等式密集（约 11 个）；MEDIUM 介于两者。难度不是文字标签而是实际改变了题面约束密度。",
      "evidence_observations": [
        13,
        27,
        50,
        54
      ],
      "persistence_evidence": null,
      "not_verifiable_reason": null
    },
    {
      "requirement_id": "f08",
      "name": "4×4 / 5×5 / 6×6 棋盘自适应",
      "grade": "partial",
      "grade_label": "部分",
      "rationale": "4x4 局完全可用：数字键 1–4、行列唯一与不等式校验、完成判定都正确（成功解出 4x4）。但配置面板里的 5x5、6x6 反复点击均不响应、始终停留在 4x4，START 后仍生成 4x4 棋盘；因此无法建立 5×5/6×6 局面，N 参数化到其它尺寸这一核心要求在可见行为上无法验证。",
      "evidence_observations": [
