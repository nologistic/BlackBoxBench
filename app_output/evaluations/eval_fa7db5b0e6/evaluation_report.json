      "not_verifiable_reason": null
    },
    {
      "requirement_id": "f09",
      "name": "动态题目生成与唯一解",
      "grade": "full",
      "grade_label": "完整",
      "rationale": "相同 4x4+MEDIUM 连续开局得到不同题面（两次预置数字与不等式布局都不一样）；不同难度 EASY/HARD 又各自生成不同的预置与不等式组合。多次生成的题面自洽，且其中一局按满足全部约束的填法可以走到 YOU WON，说明生成的是可解题目而非固定模板。",
      "evidence_observations": [
