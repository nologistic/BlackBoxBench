# Example image for the agent runtime container (strict managed-tool runs).
# Replace the CLI layer with the agent client you plan to use, then build:
#   docker build -t bbb-agent-runtime -f Dockerfile.example .
FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 ca-certificates bash \
    && rm -rf /var/lib/apt/lists/*

# CodeBuddy CLI (multi-model; npm-based, bash relay also works without python).
ARG CODEBUDDY_VERSION=2.138.0
RUN npm install -g "@tencent-ai/codebuddy-code@${CODEBUDDY_VERSION}"

# Alternatives (pick one):
# RUN npm install -g @openai/codex@0.149.0        # Codex CLI
# For Claude Code, choose and record an explicit @version before building.
