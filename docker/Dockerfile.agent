# syntax=docker/dockerfile:1@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
#
# Agent container image (docs/architecture.md §4.1).
#
# Runs the generic MCP bridge against the controller. It sits on
# `agentnet` (internal: true) and can therefore reach NOTHING except the
# controller — this is what makes the black-box guarantee hold against an
# actively adversarial agent (docs/security_model.md T1–T3).
#
# Deliberately NOT in this image: sample_apps/, schemas/, benchmark/,
# ground_truth.json, any browser/CDP tooling (T7).
#
# Build context must be the REPOSITORY ROOT:
#   docker build -f docker/Dockerfile.agent -t blackboxbench/agent .
#
# NOTE: statically reviewed only — not built or run on the authoring machine
# (no Docker available there).

FROM python:3.12-slim@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Agent-side dependency set is intentionally minimal: MCP talks HTTP.
RUN pip install --no-cache-dir httpx==0.28.1

COPY agents/ /app/agents/

RUN useradd --create-home --uid 1000 bbb \
    && chown -R bbb:bbb /app
USER bbb

ENV BBB_CONTROLLER=http://controller:7800

# Invoke through an MCP client's stdio configuration, for example with
# `docker compose run --rm -T agent` as the MCP command.
CMD ["python", "-m", "agents.cli_explorer.mcp_server"]
