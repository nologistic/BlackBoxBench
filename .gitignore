# ------------------------------------------------------------------
# BlackBoxBench .gitignore
# ------------------------------------------------------------------

# ---- 运行时产物 & 敏感数据(绝不上传) ----
# runs/ 含每会话 artifacts(截图/视频)与 live_targets 的真实登录 profile,
# 明确标注"敏感勿外传",必须完全排除。
runs/
vendor/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.test-tmp/
.playwright-cli/
.codebuddy/
/test_*.txt

# ---- 网站复现 Agent 的固定写入目录 ----
website_output/*
!website_output/.gitkeep

# ---- 2026-09-07 环境改版前的历史归档（旧交接工程/评测帧/会话证据，只读） ----
cache/

# ---- Android APK 复现输出与可重建移动素材 ----
app_output/*
!app_output/.gitkeep
reproduction/materials/generated/
app_reproduction/materials/generated/
sample_apps/android_commerce_demo/.gradle/
sample_apps/android_commerce_demo/**/build/
sample_apps/android_commerce_demo/app/src/main/res/drawable/product_camera.png
sample_apps/android_commerce_demo/app/src/main/res/raw/

# ---- 环境 / 本地配置 / 日志 ----
.env
*.log

# ---- 外部参考材料(与项目无关的论文文本) ----
2605.14415v1*.txt

# ---- 编辑器 / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
