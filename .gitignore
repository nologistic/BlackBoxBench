# ------------------------------------------------------------------
# BlackBoxBench .gitignore
# ------------------------------------------------------------------

# ---- 运行时产物 & 敏感数据(绝不上传) ----
# runs/ 含每会话 artifacts(截图/视频)与 live_targets 的真实登录 profile,
# 明确标注"敏感勿外传",必须完全排除。
runs/
vendor/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/

# ---- 环境 / 本地配置 / 日志 ----
.env
*.log

# ---- 外部参考材料(与项目无关的论文文本) ----
2605.14415v1*.txt

# ---- 编辑器 / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
