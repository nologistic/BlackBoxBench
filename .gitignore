# ------------------------------------------------------------------
# BlackBoxBench .gitignore
# ------------------------------------------------------------------

# ---- 运行时产物 & 敏感数据(绝不上传) ----
# runs/live_targets 含真实登录 profile,明确标注"敏感勿外传",必须排除。
# 2026-09-11 Linux 迁移改版:实验结果与会话证据上云(精确放行),
# 登录态 / AVD 快照 / 运行时锁 / 可再生缓存仍然排除。
runs/*
!runs/android_targets
# 2026-09-17: 探索过程（runs/sess_*）不再上云——会话证据只留在本机，
# 不上传 Git（体积大、含真实站点画面）。仅目标注册表继续跟踪。
runs/android_targets/manual_sessions/
runs/android_targets/manual_show_saved/
runs/android_targets/booting/
runs/android_targets/port_locks/
runs/android_targets/leases/
runs/android_targets/network_guard/
runs/android_targets/smoke/
runs/android_targets/extract_work/
runs/android_targets/profiles/
runs/android_targets/profiles_tmp/
runs/android_targets/apks/
runs/android_targets/artifacts/
vendor/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.test-tmp/
.playwright-cli/
.codebuddy/
/test_*.txt

# ---- 网站复现 Agent 的固定写入目录 ----
website_output/*
!website_output/.gitkeep

# ---- 2026-09-07 环境改版前的历史归档（旧交接工程/评测帧/会话证据，只读） ----
cache/

# ---- Android APK 复现输出与可重建移动素材 ----
# 2026-09-22 策略变更：实验结果（会话产物 sess_* 与评审报告 evaluations）
# 不再上云——只保留本机；Git 仅跟踪项目框架代码。
app_output/*
!app_output/.gitkeep
reproduction/materials/generated/
app_reproduction/materials/generated/
sample_apps/android_commerce_demo/.gradle/
sample_apps/android_commerce_demo/**/build/
sample_apps/android_commerce_demo/app/src/main/res/drawable/product_camera.png
sample_apps/android_commerce_demo/app/src/main/res/raw/

# ---- 环境 / 本地配置 / 日志 ----
.env
*.log

# ---- 外部参考材料(与项目无关的论文文本) ----
2605.14415v1*.txt

# ---- 编辑器 / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- local backups (never upload) ----
review_specs_backup_exclusions/
*.bak-*
